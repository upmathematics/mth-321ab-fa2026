


# import functions from packages
from sympy import symbols, Function, Eq, solve, lambdify





# define symbols
y, b = symbols('y, b')

# define the function dydt = f(y) symbolically and numerically
def f(y,b):
    f_y = Function('f')(y) # define f(y) as a function of y
    f_y = y**2 + b         # define f(y) = dy/dt
    return f_y

# print out f(y)
f(y,b)





# set up the equation
cp_equation = Eq(f(y,b),0)

# solve for y
cp = solve(cp_equation,y)

# display critical points
cp





# critical point 1
cp[0]


# critical point 2
cp[1]





# import functions from packages
import numpy as np
import matplotlib.pyplot as plt
from ipywidgets import interact, FloatSlider





# define axis limits
y_min, y_max = -5, 5
f_min, f_max = -10, 10

# define the plot with parameter b
def plot_f(b=0):
    y = np.linspace(-10, 10, 400)
    f_y = lambdify(y,f(y,b),'numpy')
    
    plt.figure(figsize=(8, 5))
    plt.plot(y, f_y, label=fr"$\sin({a:.2f}x)$")
    plt.axhline(0, color="black", linewidth=0.8)
    plt.axvline(0, color="black", linewidth=0.8)
    plt.title("Interactive Function with Parameter")
    plt.xlabel("x")
    plt.ylabel("f(x)")
    plt.legend()
    plt.grid(True)
    plt.show()

# Create interactive slider for parameter b
interact(plot_f, b=FloatSlider(value=0, min=-4, max=4, step=0.5));











